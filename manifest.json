{
  "manifest_version": 3,
  "name": "Liliana Web Pet",
  "version": "1.0.0",
  "description": "Liliana interactive web pet on Chrome and Edge.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Liliana Web Pet"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["asset/**/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
